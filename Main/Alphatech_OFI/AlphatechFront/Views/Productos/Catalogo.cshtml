@model IEnumerable<AlphatechFront.Models.Producto>
@{
    ViewData["Title"] = "Catálogo";
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
            <li class="breadcrumb-item active" aria-current="page">Catálogo</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-lg-3 mb-4">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white fw-bold text-uppercase py-3">
                    <i class="fas fa-list me-2 text-primary"></i> Categorías
                </div>
                <div class="card-body p-0 category-sidebar">
                    <div class="list-group list-group-flush">
                        <a asp-action="Catalogo" asp-route-categoriaId=""
                           class="list-group-item list-group-item-action @(ViewBag.CategoriaActual == null ? "active" : "")">
                            <i class="fas fa-th-large me-2 small"></i> Todas las categorías
                        </a>
                        @if (ViewBag.Categorias != null)
                        {
                            foreach (var cat in ViewBag.Categorias)
                            {
                                <a asp-action="Catalogo" asp-route-categoriaId="@cat.Id"
                                   class="list-group-item list-group-item-action @(ViewBag.CategoriaActual == cat.Id ? "active" : "")">
                                    <i class="fas fa-angle-right me-2 small text-muted"></i> @cat.Nombre
                                </a>
                            }
                        }
                    </div>
                </div>
            </div>

            <div class="card bg-primary text-white text-center p-3 border-0 shadow-sm">
                <h5>¿Necesitas Ayuda?</h5>
                <p class="small mb-2">Contacta a nuestros expertos en hardware.</p>
                <button class="btn btn-sm btn-light fw-bold text-primary">Chat Soporte</button>
            </div>
        </div>

        <div class="col-lg-9">

            <div class="card border-0 shadow-sm p-3 mb-4">
                <form asp-action="Catalogo" method="get">
                    <div class="row g-2 align-items-center">
                        <div class="col-md-8">
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0"><i class="fas fa-search text-muted"></i></span>
                                <input type="text" name="busqueda" class="form-control border-start-0 ps-0"
                                       placeholder="Buscar producto (ej: RTX 4060, Monitor...)" value="@ViewBag.BusquedaActual">
                            </div>
                        </div>
                        <div class="col-md-4 d-grid">
                            <button class="btn btn-primary" type="submit">Buscar</button>
                        </div>
                    </div>
                </form>
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5 bg-white rounded shadow-sm">
                    <img src="https://cdn-icons-png.flaticon.com/512/6134/6134065.png" width="100" class="mb-3 opacity-50">
                    <h4 class="text-muted">No encontramos productos</h4>
                    <p class="text-muted small">Intenta con otra categoría o término de búsqueda.</p>
                    <a asp-action="Catalogo" class="btn btn-outline-secondary mt-2">Limpiar filtros</a>
                </div>
            }
            else
            {
                <div class="row row-cols-1 row-cols-md-3 g-4">
                    @foreach (var item in Model)
                    {
                        <div class="col">
                            <div class="card h-100 product-card shadow-sm border-0">
                                <div class="p-3 text-center position-relative" style="height: 220px; display:flex; align-items:center; justify-content:center;">
                                    <img src="@(string.IsNullOrEmpty(item.ImagenUrl) ? "https://via.placeholder.com/200" : item.ImagenUrl)"
                                         class="img-fluid" style="max-height: 100%;" alt="@item.Nombre">
                                </div>
                                <div class="card-body d-flex flex-column border-top">
                                    <small class="text-muted text-uppercase" style="font-size: 0.7rem;">@item.CategoriaNombre</small>
                                    <h6 class="card-title fw-bold mt-1 text-truncate">@item.Nombre</h6>

                                    <div class="mt-auto">
                                        <p class="product-price mb-2">₡@item.Precio.ToString("N2")</p>
                                        <button class="btn btn-tech w-100" onclick="agregarAlCarrito(@item.Id)">
                                            <i class="fas fa-cart-plus me-1"></i> Añadir
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>