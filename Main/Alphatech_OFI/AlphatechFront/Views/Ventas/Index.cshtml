@model IEnumerable<AlphatechFront.Models.Venta>
@{
    ViewData["Title"] = "Gestión de Ventas";

    // --- ESTA ES LA CORRECCIÓN DE SEGURIDAD ---
    // Si Model viene nulo (null), creamos una lista vacía para que el foreach no falle.
    var listaVentas = Model ?? new List<AlphatechFront.Models.Venta>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="text-primary fw-bold mb-0">Pedidos y Ventas</h2>
        <p class="text-muted small">Administra las órdenes de los clientes</p>
    </div>
</div>

<div class="card shadow border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-uppercase text-secondary small">
                    <tr>
                        <th class="ps-4 py-3"># Pedido</th>
                        <th class="py-3">Cliente</th>
                        <th class="py-3">Fecha</th>
                        <th class="py-3">Total</th>
                        <th class="py-3">Estado</th>
                        <th class="text-end pe-4 py-3">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!listaVentas.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                <i class="fas fa-box-open fa-2x mb-2"></i><br />
                                No hay ventas registradas aún.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in listaVentas)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">#@item.Id</td>
                                <td>
                                    <div class="d-flex flex-column">
                                        <span class="fw-bold text-dark">@(item.UsuarioNombre ?? "Desconocido")</span>
                                        <small class="text-muted">@(item.UsuarioEmail ?? "Sin email")</small>
                                    </div>
                                </td>
                                <td>@item.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="fw-bold text-success">₡@item.Total.ToString("N2")</td>
                                <td>
                                    @{
                                        string estadoClass = item.Estado switch
                                        {
                                            "Pendiente" => "bg-warning text-dark",
                                            "Aprobado" => "bg-info text-dark",
                                            "Enviado" => "bg-primary",
                                            "Entregado" => "bg-success",
                                            "Cancelado" => "bg-danger",
                                            _ => "bg-secondary"
                                        };
                                    }
                                    <span class="badge @estadoClass px-3">@item.Estado</span>
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="Detalle" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary shadow-sm">
                                        <i class="fas fa-eye me-1"></i> Ver Detalle
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>