@model AlphatechFront.Models.VentaDetalleViewModel
@{
    ViewData["Title"] = "Detalle del Pedido #" + Model.Cabecera.Id;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i> Volver a Pedidos
        </a>

        <form asp-action="CambiarEstado" method="post" class="d-flex align-items-center">
            <input type="hidden" name="id" value="@Model.Cabecera.Id" />
            <label class="me-2 fw-bold text-muted small">CAMBIAR ESTADO:</label>
            <select name="estado" class="form-select form-select-sm w-auto me-2" onchange="this.form.submit()">
                <option value="Pendiente" selected="@(Model.Cabecera.Estado == "Pendiente")">Pendiente</option>
                <option value="Aprobado" selected="@(Model.Cabecera.Estado == "Aprobado")">Aprobado (En Proceso)</option>
                <option value="Enviado" selected="@(Model.Cabecera.Estado == "Enviado")">Enviado</option>
                <option value="Entregado" selected="@(Model.Cabecera.Estado == "Entregado")">Entregado</option>
                <option value="Cancelado" selected="@(Model.Cabecera.Estado == "Cancelado")">Cancelado</option>
            </select>
        </form>
    </div>

    <div class="row">
        <div class="col-lg-4 mb-4">
            <div class="card shadow border-0 mb-3">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0"><i class="fas fa-user me-2"></i>Cliente</h5>
                </div>
                <div class="card-body">
                    <h5 class="fw-bold">@Model.Cabecera.UsuarioNombre</h5>
                    <p class="mb-1"><i class="fas fa-envelope text-muted me-2"></i> @Model.Cabecera.UsuarioEmail</p>
                    <hr />
                    <h6 class="text-uppercase text-muted small fw-bold">Dirección de Envío</h6>
                    <p class="mb-0"><i class="fas fa-map-marker-alt text-danger me-2"></i> @Model.Cabecera.DireccionEnvio</p>
                </div>
            </div>

            <div class="card shadow border-0">
                <div class="card-header bg-light py-3">
                    <h5 class="mb-0"><i class="fas fa-info-circle me-2"></i>Resumen</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <span>Fecha:</span>
                        <strong>@Model.Cabecera.Fecha.ToString("dd/MM/yyyy")</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Cupón:</span>
                        <span class="text-success">@(Model.Cabecera.CuponAplicado ?? "No aplica")</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                        <span class="h5 mb-0">Total:</span>
                        <span class="h4 text-primary fw-bold mb-0">₡@Model.Cabecera.Total.ToString("N2")</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card shadow border-0">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-bold">Productos Solicitados</h5>
                </div>
                <div class="card-body p-0">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4">Producto</th>
                                <th class="text-center">Cant.</th>
                                <th class="text-end">Precio Unit.</th>
                                <th class="text-end pe-4">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var det in Model.Detalles)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center">
                                            <img src="@det.ProductoImagen" class="rounded border me-3" style="width: 50px; height: 50px; object-fit: cover;">
                                            <div>
                                                <div class="fw-bold">@det.ProductoNombre</div>
                                                <small class="text-muted">ID: @det.id_producto</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-center">@det.Cantidad</td>
                                    <td class="text-end">₡@det.PrecioUnitario.ToString("N2")</td>
                                    <td class="text-end pe-4 fw-bold">₡@det.Subtotal.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>