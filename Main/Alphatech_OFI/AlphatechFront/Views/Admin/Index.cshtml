@model IEnumerable<AlphatechFront.Models.Venta>
@{
    ViewData["Title"] = "Dashboard Administrativo";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="text-primary fw-bold mb-0">Dashboard General</h2>
        <p class="text-muted small">Resumen de actividad de Alphatech</p>
    </div>
    <div class="text-end">
        <span class="badge bg-white text-dark border p-2 shadow-sm">
            <i class="fas fa-calendar-alt me-2"></i> @DateTime.Now.ToString("dd MMM yyyy")
        </span>
    </div>
</div>

<div class="row g-4 mb-5">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm overflow-hidden h-100">
            <div class="card-body position-relative">
                <div class="d-flex align-items-center mb-3">
                    <div class="bg-success bg-opacity-10 p-3 rounded-circle text-success me-3">
                        <i class="fas fa-money-bill-wave fa-2x"></i>
                    </div>
                    <h6 class="card-title text-muted text-uppercase fw-bold mb-0">Ingresos Totales</h6>
                </div>
                <h3 class="fw-bold text-dark mb-0">₡@ViewBag.TotalIngresos.ToString("N0")</h3>
            </div>
            <div class="card-footer bg-success bg-opacity-25 border-0 py-1"></div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm overflow-hidden h-100">
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <div class="bg-primary bg-opacity-10 p-3 rounded-circle text-primary me-3">
                        <i class="fas fa-shopping-bag fa-2x"></i>
                    </div>
                    <h6 class="card-title text-muted text-uppercase fw-bold mb-0">Ventas Realizadas</h6>
                </div>
                <h3 class="fw-bold text-dark mb-0">@ViewBag.TotalVentas</h3>
                <small class="text-warning fw-bold"><i class="fas fa-clock me-1"></i> @ViewBag.OrdenesPendientes Pendientes</small>
            </div>
            <div class="card-footer bg-primary bg-opacity-25 border-0 py-1"></div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm overflow-hidden h-100">
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <div class="bg-info bg-opacity-10 p-3 rounded-circle text-info me-3">
                        <i class="fas fa-users fa-2x"></i>
                    </div>
                    <h6 class="card-title text-muted text-uppercase fw-bold mb-0">Clientes Registrados</h6>
                </div>
                <h3 class="fw-bold text-dark mb-0">@ViewBag.TotalUsuarios</h3>
            </div>
            <div class="card-footer bg-info bg-opacity-25 border-0 py-1"></div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm overflow-hidden h-100">
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <div class="bg-warning bg-opacity-10 p-3 rounded-circle text-warning me-3">
                        <i class="fas fa-box-open fa-2x"></i>
                    </div>
                    <h6 class="card-title text-muted text-uppercase fw-bold mb-0">Productos Activos</h6>
                </div>
                <h3 class="fw-bold text-dark mb-0">@ViewBag.TotalProductos</h3>
            </div>
            <div class="card-footer bg-warning bg-opacity-25 border-0 py-1"></div>
        </div>
    </div>
</div>

<div class="card shadow border-0">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h6 class="m-0 font-weight-bold text-primary">Últimas Ventas</h6>
        <a asp-controller="Ventas" asp-action="Index" class="btn btn-sm btn-outline-primary">Ver todas</a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table align-middle mb-0 table-hover">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Cliente</th>
                        <th>Fecha</th>
                        <th>Estado</th>
                        <th class="text-end pe-4">Monto</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 text-primary fw-bold">#@item.Id</td>
                            <td>@item.UsuarioEmail</td>
                            <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (item.Estado == "Pendiente")
                                {
                                    <span class="badge bg-warning text-dark">Pendiente</span>
                                }
                                else if (item.Estado == "Enviado")
                                {

                                    <span class="badge bg-primary">Enviado</span>
                                }
                                else
                                {

                                    <span class="badge bg-secondary">@item.Estado</span>
                                }
                            </td>
                            <td class="text-end pe-4 fw-bold">₡@item.Total.ToString("N0")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>