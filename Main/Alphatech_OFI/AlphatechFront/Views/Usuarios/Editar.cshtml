@model AlphatechFront.ViewModels.EditarUsuarioViewModel
@{
    ViewData["Title"] = "Editar Usuario";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0"><i class="fas fa-user-edit me-2"></i>Editar Usuario</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Editar">
                        <input type="hidden" asp-for="Id" />

                        <div class="mb-3">
                            <label asp-for="NombreCompleto" class="form-label fw-bold">Nombre Completo</label>
                            <input asp-for="NombreCompleto" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-bold">Correo Electrónico</label>
                            <input asp-for="Email" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label asp-for="Rol" class="form-label fw-bold">Rol del Sistema</label>
                            <select asp-for="Rol" class="form-select" asp-items="ViewBag.Roles"></select>
                        </div>

                        <div class="alert alert-info small">
                            <i class="fas fa-info-circle me-1"></i> La contraseña no se puede cambiar desde aquí.
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                            <a asp-action="Index" class="btn btn-secondary me-md-2">Cancelar</a>
                            <button type="submit" class="btn btn-primary px-4">Guardar Cambios</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}