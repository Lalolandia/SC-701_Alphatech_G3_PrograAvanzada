@model AlphatechFront.Models.Categoria
@{
    ViewData["Title"] = "Nueva Categoría";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-tags me-2"></i>Crear Categoría</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Crear">
                        <div class="mb-3">
                            <label asp-for="Nombre" class="form-label fw-bold">Nombre de la Categoría</label>
                            <input asp-for="Nombre" class="form-control form-control-lg" placeholder="Ej. Laptops" />
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                            <a asp-action="Index" class="btn btn-secondary me-md-2">Cancelar</a>
                            <button type="submit" class="btn btn-success px-4">Guardar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}
