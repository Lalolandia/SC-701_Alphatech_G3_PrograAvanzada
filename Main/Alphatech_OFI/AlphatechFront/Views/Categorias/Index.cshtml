@model IEnumerable<AlphatechFront.Models.Categoria>
@{
    ViewData["Title"] = "Gestión de Categorías";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="text-primary fw-bold mb-0">Categorías</h2>
        <p class="text-muted small">Organiza tu inventario</p>
    </div>
    <a asp-action="Crear" class="btn btn-primary shadow-sm rounded-pill px-4">
        <i class="fas fa-plus me-2"></i>Nueva Categoría
    </a>
</div>

<div class="card shadow border-0 col-md-8">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light text-uppercase text-secondary small">
                <tr>
                    <th class="ps-4 py-3">ID</th>
                    <th class="py-3">Nombre</th>
                    <th class="text-end pe-4 py-3">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4 fw-bold text-muted">#@item.Id</td>
                        <td class="fw-bold">
                            <i class="fas fa-tag text-primary me-2"></i> @item.Nombre
                        </td>
                        <td class="text-end pe-4">
                            <a asp-action="Editar" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1" data-bs-toggle="tooltip" title="Editar Categoría">
                                <i class="fas fa-edit"></i>
                            </a>

                            <button type="button" class="btn btn-sm btn-outline-danger"
                                    data-bs-toggle="tooltip" title="Eliminar Categoría"
                                    onclick="confirmarEliminacion(@item.Id, '@item.Nombre')">
                                <i class="fas fa-trash-alt"></i>
                            </button>

                            <form id="form-eliminar-@item.Id" asp-action="Eliminar" asp-route-id="@item.Id" method="post" style="display:none;"></form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        // Activar Tooltips
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl)
        })

        // Confirmación SweetAlert
        function confirmarEliminacion(id, nombre) {
            Swal.fire({
                title: '¿Eliminar Categoría?',
                text: "Estás intentando borrar: " + nombre + ". Si tiene productos, dará error.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Sí, intentar borrar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('form-eliminar-' + id).submit();
                }
            })
        }
    </script>
}