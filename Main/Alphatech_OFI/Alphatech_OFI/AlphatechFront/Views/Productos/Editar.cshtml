@model AlphatechFront.Models.Producto

@{
    ViewData["Title"] = "Editar Producto";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow border-0">
                <div class="card-header bg-warning text-dark py-3">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-edit me-2"></i>Editar Producto: @Model.Nombre</h5>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Editar" enctype="multipart/form-data">

                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="ImagenUrl" />

                        <div class="row mb-3">
                            <div class="col-md-12">
                                <label asp-for="Nombre" class="form-label fw-bold text-muted small text-uppercase">Nombre</label>
                                <input asp-for="Nombre" class="form-control form-control-lg" />
                                <span asp-validation-for="Nombre" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label asp-for="CategoriaId" class="form-label fw-bold text-muted small text-uppercase">Categoría</label>
                                <select asp-for="CategoriaId" class="form-select" asp-items="ViewBag.Categorias">
                                    <option value="">-- Seleccionar --</option>
                                </select>
                                <span asp-validation-for="CategoriaId" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="Precio" class="form-label fw-bold text-muted small text-uppercase">Precio</label>
                                <div class="input-group">
                                    <span class="input-group-text">₡</span>
                                    <input asp-for="Precio" type="number" step="0.01" class="form-control" />
                                </div>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="Stock" class="form-label fw-bold text-muted small text-uppercase">Stock</label>
                                <input asp-for="Stock" type="number" class="form-control" />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Descripcion" class="form-label fw-bold text-muted small text-uppercase">Descripción</label>
                            <textarea asp-for="Descripcion" class="form-control" rows="4"></textarea>
                        </div>

                        <div class="row align-items-center mb-4 p-3 bg-light rounded mx-1">
                            <div class="col-md-4 text-center">
                                <label class="d-block fw-bold small text-muted mb-2">IMAGEN ACTUAL</label>
                                <img src="@Model.ImagenUrl" class="img-thumbnail shadow-sm bg-white" style="max-height: 120px; max-width: 100%;" onerror="this.src='/imagenes/default.png'" />
                            </div>
                            <div class="col-md-8">
                                <label class="form-label fw-bold">¿Cambiar Imagen? (Opcional)</label>
                                <input type="file" name="imagenArchivo" class="form-control" accept="image/*" />
                                <small class="text-muted fst-italic">Si no subes nada, se mantiene la foto actual.</small>
                            </div>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end border-top pt-3">
                            <a asp-action="Index" class="btn btn-outline-secondary me-md-2 px-4">Cancelar</a>
                            <button type="submit" class="btn btn-primary px-5 fw-bold">Actualizar Cambios</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}