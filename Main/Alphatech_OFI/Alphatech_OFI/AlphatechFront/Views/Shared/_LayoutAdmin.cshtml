<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Alphatech</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        /* Estilos rápidos para el Sidebar */
        body { min-height: 100vh; display: flex; flex-direction: column; }
        .wrapper { display: flex; width: 100%; align-items: stretch; flex: 1; }
        #sidebar { min-width: 250px; max-width: 250px; background: #343a40; color: #fff; transition: all 0.3s; }
        #sidebar .sidebar-header { padding: 20px; background: #343a40; }
        #sidebar ul.components { padding: 20px 0; border-bottom: 1px solid #4b545c; }
        #sidebar ul li a { padding: 10px; font-size: 1.1em; display: block; color: #fff; text-decoration: none; }
        #sidebar ul li a:hover { color: #343a40; background: #fff; }
        #content { width: 100%; padding: 20px; background-color: #f8f9fa; }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark border-bottom">
        <div class="container-fluid">
            <span class="navbar-brand mb-0 h1 ps-3">Alphatech Admin</span>
            <div class="d-flex">
                <a href="/" class="btn btn-outline-light btn-sm">Ir a la Tienda</a>
            </div>
        </div>
    </nav>

    <div class="wrapper">
        <nav id="sidebar">
            <div class="sidebar-header">
                <h3>Menu</h3>
            </div>

            <ul class="list-unstyled components">
                <li>
                    <a asp-controller="Admin" asp-action="Index">
                        <i class="fas fa-home me-2"></i> Dashboard
                    </a>
                </li>
                <li>
                    <a asp-controller="Productos" asp-action="Index">
                        <i class="fas fa-box me-2"></i> Productos
                    </a>
                </li>
                <li>
                    <a asp-controller="Usuario" asp-action="Index">
                        <i class="fas fa-users me-2"></i> Usuarios
                    </a>
                </li>
                <li>
                    <a asp-controller="Rol" asp-action="Index">
                        <i class="fas fa-user-tag me-2"></i> Roles
                    </a>
                </li>
                <li>
                    <a asp-controller="Ventas" asp-action="Index">
                        <i class="fas fa-shopping-cart me-2"></i> Ventas
                    </a>
                </li>
            </ul>
        </nav>

        <div id="content">
            @RenderBody()
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>