<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AlphatechFront</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AlphatechFront.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <style>
        /* Estilos base */
        body {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Sidebar Admin Styles */
        .sidebar {
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            z-index: 100;
            padding: 48px 0 0;
            box-shadow: inset -1px 0 0 rgba(0, 0, 0, .1);
            background-color: #fff;
        }

        .sidebar-sticky {
            position: relative;
            top: 0;
            height: calc(100vh - 48px);
            padding-top: .5rem;
            overflow-x: hidden;
            overflow-y: auto;
        }

        .sidebar .nav-link {
            font-weight: 500;
            color: #333;
            padding: 10px 20px;
        }

            .sidebar .nav-link:hover {
                color: #007bff;
                background-color: #f8f9fa;
            }

            .sidebar .nav-link.active {
                color: #007bff;
                background-color: #e9ecef;
                border-right: 3px solid #007bff;
            }

            .sidebar .nav-link i {
                margin-right: 10px;
                width: 20px;
                text-align: center;
            }

        /* Main Content Admin */
        .main-content-admin {
            margin-left: 250px;
            width: calc(100% - 250px);
            background-color: #f8f9fe;
            min-height: 100vh;
        }

        .admin-header {
            background: linear-gradient(87deg, #5e72e4 0, #825ee4 100%);
            padding-bottom: 2rem;
            padding-top: 1rem;
        }
    </style>
</head>

@using AlphatechFront.Models
@using Microsoft.AspNetCore.Identity

@inject SignInManager<Usuario> SignInManager
@inject UserManager<Usuario> UserManager

@{
        // Verificar si es admin usando la clase correcta
        bool esAdmin = SignInManager.IsSignedIn(User) && User.IsInRole("Admin");
}

<body>

    @if (esAdmin)
    {
        /* =========================================================
        DISEÑO 1: ADMINISTRADOR (SIDEBAR FIJO + PANEL)
        ========================================================= */
        <div class="container-fluid p-0">
            <div class="row g-0">
                <nav id="sidebarMenu" class="col-md-3 col-lg-2 d-md-block bg-white sidebar collapse shadow">
                    <div class="position-sticky pt-3">
                        <div class="text-center mb-4">
                            <h4 class="text-primary fw-bold"><i class="fas fa-microchip"></i> Alphatech</h4>
                            <small class="text-muted text-uppercase">Panel Administrativo</small>
                        </div>

                        <h6 class="sidebar-heading d-flex justify-content-between align-items-center px-3 mt-4 mb-1 text-muted text-uppercase">
                            <span>Gestión Principal</span>
                        </h6>
                        <ul class="nav flex-column">
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">
                                    <i class="fas fa-tachometer-alt"></i> Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Productos" ? "active" : "")" asp-controller="Productos" asp-action="Index">
                                    <i class="fas fa-box"></i> Productos
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Categorias" ? "active" : "")" asp-controller="Categorias" asp-action="Index">
                                    <i class="fas fa-tags"></i> Categorías
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Ventas" ? "active" : "")" asp-controller="Ventas" asp-action="Index">
                                    <i class="fas fa-money-bill-wave"></i> Ventas
                                </a>
                            </li>
                        </ul>

                        <h6 class="sidebar-heading d-flex justify-content-between align-items-center px-3 mt-4 mb-1 text-muted text-uppercase">
                            <span>Seguridad</span>
                        </h6>
                        <ul class="nav flex-column mb-2">
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Usuario" ? "active" : "")" asp-controller="Usuario" asp-action="Index">
                                    <i class="fas fa-users"></i> Usuarios
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Rol" ? "active" : "")" asp-controller="Rol" asp-action="Index">
                                    <i class="fas fa-user-shield"></i> Roles
                                </a>
                            </li>
                        </ul>

                        <div class="mt-5 px-3">
                            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                                <button type="submit" class="btn btn-outline-danger w-100"><i class="fas fa-sign-out-alt"></i> Cerrar Sesión</button>
                            </form>
                        </div>
                    </div>
                </nav>

                <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 bg-light min-vh-100">
                    <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom bg-white px-3 shadow-sm rounded mt-2">
                        <h1 class="h2">Bienvenido, @User.Identity?.Name</h1>
                        <div class="btn-toolbar mb-2 mb-md-0">
                            <div class="dropdown me-3">
                                <a class="nav-link position-relative text-dark" href="#" id="notifAdmin" role="button" data-bs-toggle="dropdown">
                                    <i class="fas fa-bell fa-lg"></i>
                                    <span id="contadorNotificacionesAdmin" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">0</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="notifAdmin" id="listaNotificacionesAdmin">
                                    <li><span class="dropdown-item">Cargando...</span></li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <div class="card shadow-sm border-0">
                        <div class="card-body">
                            @RenderBody()
                        </div>
                    </div>

                    <footer class="pt-3 mt-4 text-muted text-center border-top">
                        &copy; 2025 - Alphatech Admin Panel
                    </footer>
                </main>
            </div>
        </div>
    }
    else
    {
        /* =========================================================
        DISEÑO 2: USUARIO CLIENTE (NAVBAR NORMAL)
        ========================================================= */
        <header>
            <nav class="navbar navbar-expand-sm navbar-tech shadow-sm mb-3 bg-white">
                <div class="container">
                    <a class="navbar-brand fw-bold text-primary" asp-area="" asp-controller="Home" asp-action="Index">
                        <i class="fas fa-microchip me-2"></i> Alphatech
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Inicio</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Productos" asp-action="Catalogo">Catálogo</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Home" asp-action="Privacy">Privacidad</a></li>
                        </ul>

                        <ul class="navbar-nav">
                            <li class="nav-item"><a class="nav-link" asp-controller="Favorito" asp-action="Index" title="Favoritos"><i class="fas fa-heart text-danger"></i></a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Carrito" asp-action="Index" title="Carrito"><i class="fas fa-shopping-cart text-primary"></i></a></li>

                            <li class="nav-item dropdown mx-2">
                                <a class="nav-link position-relative" href="#" id="notificacionesDropdown" role="button" data-bs-toggle="dropdown">
                                    <i class="fas fa-bell text-secondary"></i>
                                    <span id="contadorNotificaciones" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">0</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="notificacionesDropdown" style="max-height:300px; overflow-y:auto;" id="listaNotificaciones">
                                    <li><span class="dropdown-item">Sin notificaciones</span></li>
                                </ul>
                            </li>

                            <partial name="_LoginPartial" />
                        </ul>
                    </div>
                </div>
            </nav>
        </header>

        <div class="container">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>

        <footer class="bg-light text-center text-muted py-4 mt-auto border-top">
            <div class="container">
                <p class="mb-1">&copy; 2025 - Alphatech Store</p>
                <div class="small">
                    <a href="#" class="text-decoration-none mx-2">Términos</a> |
                    <a href="#" class="text-decoration-none mx-2">Privacidad</a> |
                    <a href="#" class="text-decoration-none mx-2">Contacto</a>
                </div>
            </div>
        </footer>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        const API_URL_NOTIFICACIONES = '/api/notificaciones';

        function cargarNotificaciones() {
            // Verifica si hay un contenedor de notificaciones en pantalla
            const listaUser = $("#listaNotificaciones");
            const listaAdmin = $("#listaNotificacionesAdmin");

            // Si no existen los elementos en el DOM, no hacemos la llamada (ahorra recursos)
            if (listaUser.length === 0 && listaAdmin.length === 0) return;

            $.get(API_URL_NOTIFICACIONES, function (notificaciones) {
                // Limpiar listas
                if(listaUser.length) listaUser.empty();
                if(listaAdmin.length) listaAdmin.empty();

                let noLeidas = 0;
                let htmlContent = "";

                if (!notificaciones || notificaciones.length === 0) {
                    htmlContent = '<li><span class="dropdown-item small">Sin notificaciones</span></li>';
                } else {
                    notificaciones.forEach(n => {
                        if (!n.leida) noLeidas++;
                        htmlContent += `
                            <li>
                                <a class="dropdown-item ${n.leida ? '' : 'fw-bold bg-light'}" href="${n.url || '#'}" onclick="marcarLeida(${n.id})">
                                    <small>${n.mensaje}</small> <br/>
                                    <span class="text-muted" style="font-size:10px">${new Date(n.fecha).toLocaleString()}</span>
                                </a>
                            </li>
                            <li><hr class="dropdown-divider m-0"></li>
                        `;
                    });
                }

                // Actualizar UI Usuario
                if(listaUser.length) {
                    listaUser.append(htmlContent);
                    $("#contadorNotificaciones").text(noLeidas > 0 ? noLeidas : "");
                }

                // Actualizar UI Admin
                if(listaAdmin.length) {
                    listaAdmin.append(htmlContent);
                    $("#contadorNotificacionesAdmin").text(noLeidas > 0 ? noLeidas : "");
                }
            });
        }

        function marcarLeida(id) {
            $.ajax({
                url: `${API_URL_NOTIFICACIONES}/marcarleidas`,
                type: 'PUT',
                contentType: 'application/json',
                data: JSON.stringify([id]),
                success: cargarNotificaciones
            });
        }

        $(document).ready(function () {
            cargarNotificaciones();
            setInterval(cargarNotificaciones, 30000);
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>